@prefix fdp-ri: <https://w3id.org/fdp/fdp-ri-o#> .
@prefix fdp-o:  <https://w3id.org/fdp/fdp-o#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# Vocabulary of the FAIR Data Point reference implementation.
#
# FDP-O (https://w3id.org/fdp/fdp-o) describes what any FAIR Data Point exposes.
# FDP-RI-O describes how this implementation stores its own configuration in the
# triple store: record state, metadata schema versions, resource definitions,
# settings and the RDF-migration log. Terms are added as the corresponding
# repositories are implemented; anything found to be implementation-agnostic is
# proposed to FDP-O instead.

<https://w3id.org/fdp/fdp-ri-o>
    a owl:Ontology ;
    dct:title "FAIR Data Point Reference Implementation Ontology"@en ;
    dct:description "Terms used by the FAIR Data Point reference implementation to store its configuration in the triple store."@en ;
    dct:license <https://opensource.org/licenses/MIT> ;
    owl:imports <https://w3id.org/fdp/fdp-o> ;
    owl:versionInfo "2.0-draft" .

fdp-ri:SystemGraph
    a owl:Class ;
    rdfs:label "system graph"@en ;
    rdfs:comment "The named graph in which a reference implementation keeps its configuration. The graph IRI is https://w3id.org/fdp/fdp-ri-o/system."@en .

fdp-ri:RecordState
    a owl:Class ;
    rdfs:label "record state"@en ;
    rdfs:comment "State of a metadata record in a reference implementation: a record is either a draft, visible to authenticated users only, or published."@en .

fdp-ri:Draft
    a owl:NamedIndividual, fdp-ri:RecordState ;
    rdfs:label "draft"@en ;
    rdfs:comment "The record is being prepared and is only served to authenticated users."@en .

fdp-ri:Published
    a owl:NamedIndividual, fdp-ri:RecordState ;
    rdfs:label "published"@en ;
    rdfs:comment "The record is served to everybody, including anonymous clients."@en .

fdp-ri:hasState
    a owl:ObjectProperty ;
    rdfs:label "has state"@en ;
    rdfs:comment "Relates a metadata record to its state. The statement is kept in the state sub-graph of the system graph (https://w3id.org/fdp/fdp-ri-o/system/state), never in the graph of the record itself. The domain is intentionally left open: records have no single RDF type, so the domain is any resource that is a metadata record of this FAIR Data Point."@en ;
    rdfs:range fdp-ri:RecordState .
